@using Microsoft.AspNetCore.Mvc.Localization
@using FreeERP.Localization
@inject IHtmlLocalizer<FreeERPResource> L
@model FreeERP.Settings.HelpSettingDto

<form id="HelpSettingsForm">
    <abp-row>
        <abp-column size-md="_12">
            <div>
                <abp-input asp-for="IsShow" label="@L["HelpSettingShow"].Value" />
            </div>
            <hr class="my-4" />
            <div>
                <abp-button button-type="Primary" type="submit"><i class="fa fa-save"></i> @L["Save"]
                </abp-button>
            </div>
        </abp-column>
    </abp-row>
</form>
