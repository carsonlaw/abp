@using FreeERP.Web.Components;
@using FreeERP.Products;
@model CategoryDto;

<div class="dropdown-submenu btn-group">
    <a role="button" class="btn categoryitem " categoryid="@Model.Id">
        <span>
            @Model.Name
        </span>
    </a>
    @if (Model.Items.Count > 0)
    {
        <a role="button" class="btn dropdown-toggle dropdown-toggle-split" data-toggle="dropdown" aria-haspopup="true"
        aria-expanded="false">
        </a>
    }
    <div class="dropdown-menu border-0 shadow-sm">
        @foreach (var item in Model.Items)
        {
            @await Component.InvokeAsync(typeof(CategoryItemWidgetViewComponent),item)
        }
    </div>
</div>