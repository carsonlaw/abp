@page
@using FreeERP.Web.Components
@using FreeERP.Web.Pages;
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal

@inherits FreeERPPageBase

@model ProductUnitCreateModalModel

@{
    Layout = null;
}

<abp-dynamic-form abp-model="ViewModel" asp-page="/Products/ProductUnitCreateModal">
    <abp-modal>
        <abp-modal-header title="@L["New"].Value"></abp-modal-header>
        <abp-modal-body>
            @await Component.InvokeAsync(typeof(ProductUnitWidgetViewComponent),new ProductUnitWidgetModel(){
            Id="ProductUnitCreate", InputName="Pid", SelectText=L["ProductUnitParentSelect"].Value })
            <abp-form-content />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>