@page
@using Microsoft.AspNetCore.Mvc.Localization
@using FreeERP.Localization
@using FreeERP.Web.Components;
@using FreeERP.Web.Pages;
@using FreeERP.Web.Menus;
@using Volo.Abp.AspNetCore.Mvc.UI.Packages.Slugify
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.Shared.Pages.Shared.Components.AbpPageToolbar
@inherits FreeERPPageBase
@inject IHtmlLocalizer<FreeERPResource> L

@model CategoryModel

@{
    PageLayout.Content.Title = "分类管理";
    PageLayout.Content.BreadCrumb.Add(L["Menu:FreeERP"].Value);
    PageLayout.Content.MenuItemName = FreeERPMenus.Category;
}

@section scripts {
<abp-script-bundle>
    <abp-script src="/Pages/Products/Category.js" />
</abp-script-bundle>
}
@section content_toolbar {
@await Component.InvokeAsync(typeof(AbpPageToolbarViewComponent), new { pageName = typeof(CategoryModel).FullName })
}

<abp-card class="mb-4">
    <abp-card-body>
        <form id="CategoryFilterForm" method="post">
            <abp-row>
                <abp-column size-lg="_3" size-md="_6">
                    @await Component.InvokeAsync(typeof(CategoryWidgetViewComponent),new CategoryWidgetModel(){
                    Id="CategoryCate", InputName="CategoryId", SelectText=L["CategorySelect"].Value })
                </abp-column>
                <abp-column size-lg="_3" size-md="_6">
                    <abp-input asp-for="@Model.Filter" label="@L["CategoryName"].Value" type="text" />
                </abp-column>

                <abp-column size-lg="_2" size-md="_6">
                    <div class="d-grid gap-2">
                        <abp-button class="mt-md-4" button-type="Primary" type="submit"
                            style="margin-top: 1.75rem !important;">
                            <i class="fa fa-search" aria-hidden="true"></i>
                        </abp-button>
                    </div>
                </abp-column>
            </abp-row>
        </form>
    </abp-card-body>
</abp-card>

<abp-card>
    <abp-card-body>
        <abp-table striped-rows="true" id="CategoryTable" class="nowrap"></abp-table>
    </abp-card-body>
</abp-card>