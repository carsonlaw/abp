@page
@using Microsoft.AspNetCore.Mvc.Localization
@using FreeERP.Localization
@using FreeERP.Web.Components;
@using FreeERP.Web.Pages;
@using Volo.Abp.AspNetCore.Mvc.UI.Packages.Slugify
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.Shared.Pages.Shared.Components.AbpPageToolbar

@inject IHtmlLocalizer<FreeERPResource> L

@model ProductModel

@section scripts {
<abp-script-bundle>
    <abp-script src="/Pages/Products/product.js" />
</abp-script-bundle>
}
@section content_toolbar {
@await Component.InvokeAsync(typeof(AbpPageToolbarViewComponent), new { pageName = typeof(ProductModel).FullName })
}


<div id="ProductWrapper">
    <abp-card>
        <abp-card-body>
            @await Component.InvokeAsync(typeof(CategoryWidgetViewComponent),new CategoryWidgetModel(){
            Id="ProductCate", InputName="CategoryId", SelectText=L["CategorySelect"].Value })
            <abp-table striped-rows="true" id="ProductTable" class="nowrap"></abp-table>
        </abp-card-body>
    </abp-card>
</div>
