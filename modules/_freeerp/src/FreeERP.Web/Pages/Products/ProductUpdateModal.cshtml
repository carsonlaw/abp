@page
@using FreeERP.Web.Pages
@using FreeERP.Web.Components
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal

@inherits FreeERPPageBase

@model ProductUpdateModalModel

@{
    Layout = null;
}

<abp-dynamic-form abp-model="ViewModel" asp-page="/Products/ProductUpdateModal">
    <abp-modal>
        <abp-modal-header title="@L["Edit"].Value"></abp-modal-header>
        <abp-modal-body>
            @await Component.InvokeAsync(typeof(ProductUnitWidgetViewComponent),new ProductUnitWidgetModel(){
            Id="ProductUpdate", InputName="UnitId", SelectText=L["ProductUnitSelect"].Value,
            Value=Model.ViewModel.UnitId.ToString()
            })

            <abp-input asp-for="Id" />
            <abp-form-content />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</abp-dynamic-form>