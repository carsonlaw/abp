@using FreeERP.Products;
@using FreeERP.Web.Components;
@model CategoryWidgetModel;

<div class="navbar category">
    <div class="divbread" style="display: none;">
        <abp-breadcrumb>
        </abp-breadcrumb>
    </div>
    <div class="dropdown divselect">
        <a class="btn dropdown-toggle" id="Sel_@Model.Id" data-toggle="dropdown" aria-haspopup="true"
            aria-expanded="false">
            @Model.SelectText
        </a>
        <div class="dropdown-menu border-0 shadow-sm" aria-labelledby=" Sel_@Model.Id">

            @foreach (var cate in Model.Items)
            {
                @await Component.InvokeAsync(typeof(CategoryItemWidgetViewComponent),cate)
            }
        </div>
    </div>
    <input type="hidden" class="categoryinput" name="@Model.InputName" id="@Model.InputName"></input>
</div>