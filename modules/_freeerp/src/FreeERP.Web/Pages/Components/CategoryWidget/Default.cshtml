@using FreeERP.Products;
@using FreeERP.Web.Components;
@model List<CategoryDto>;

<div class="navbar category">
    <abp-breadcrumb style="display: none;">
    </abp-breadcrumb>
    <div class="dropdown">
        <a class="btn dropdown-toggle" id="Category" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            选择类别
        </a>
        <div class="dropdown-menu border-0 shadow-sm " aria-labelledby="Category">

            @foreach (var cate in Model)
            {
                @await Component.InvokeAsync(typeof(CategoryItemWidgetViewComponent),cate)
            }
        </div>
    </div>
    <input type="text" name="CategoryId" id="CategoryId"></input>
</div>