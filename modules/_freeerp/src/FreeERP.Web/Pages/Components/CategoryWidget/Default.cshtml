@using FreeERP.Products;
@using FreeERP.Web.Components;
@model List<CategoryDto>;

<div class="navbar">
    <div class="dropdown">
        <a class="btn dropdown-toggle" id="Menu_" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            选择类别
        </a>
        <div class="dropdown-menu border-0 shadow-sm " aria-labelledby="Menu_">

            @foreach (var cate in Model)
            {
                @await Component.InvokeAsync(typeof(CategoryItemWidgetViewComponent),cate)
            }
        </div>
    </div>
</div>