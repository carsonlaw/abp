@using FreeERP.Web.Components;
@using FreeERP.Products;
@model CategoryDto;

<div class="dropdown-submenu">
    <a role="button" class="btn categoryitem dropdown-toggle" categoryid="@Model.Id" data-toggle="dropdown"
        aria-haspopup="true" aria-expanded="false">
        <span>
            @Model.Name
        </span>
    </a>
    <div class="dropdown-menu border-0 shadow-sm">
        @foreach (var item in Model.Items)
        {
            @await Component.InvokeAsync(typeof(CategoryItemWidgetViewComponent),item)
        }
    </div>
</div>