@page
@using Microsoft.AspNetCore.Mvc.Localization
@using FreeERP.Localization
@using FreeERP.Web.Components;
@using FreeERP.Web.Pages;
@using FreeERP.Web.Menus;
@using Volo.Abp.AspNetCore.Mvc.UI.Packages.Slugify
@using Volo.Abp.AspNetCore.Mvc.UI.Theme.Shared.Pages.Shared.Components.AbpPageToolbar
@inherits FreeERPPageBase

@model PurchaseOrderModel

@{
    PageLayout.Content.Title = L["Menu:PurchaseOrder"].Value;
    PageLayout.Content.BreadCrumb.Add(L["Menu:FreeERP"].Value);
    PageLayout.Content.MenuItemName = FreeERPMenus.PurchaseOrder;
}

@section scripts {
<abp-script-bundle>
    <abp-script src="/Pages/Purchases/PurchaseOrder.js" />
</abp-script-bundle>
}
@section styles
{
<style>
    .input-group-sm div {
        width: 33%
    }
</style>
}
@section content_toolbar {
@await Component.InvokeAsync(typeof(AbpPageToolbarViewComponent), new { pageName = typeof(PurchaseOrderModel).FullName
})
}


<div id="PurchaseOrderWrapper">
    <abp-card class="mb-4">
        <abp-card-body>
            <form id="PurchaseOrderFilterForm" method="post">
                <abp-row>
                    <abp-column size-lg="_4" size-md="_12">

                    </abp-column>
                    <abp-column size-lg="_4" size-md="_12">
                        <div class="input-group">
                            <div class="mb-3"><span class="input-group-text border-end-0 rounded-0 rounded-start">
                                    订单时间
                                </span>
                            </div>
                            <abp-input asp-for="@Model.OrderTimeBegin" style="width:7.2em"
                                class="border-start-0 rounded-0 rounded-end" suppress-label="true" type="date" />
                            <span class="input-group-addon">-</span>
                            <abp-input asp-for="@Model.OrderTimeEnd" style="width:7.2em" suppress-label="true"
                                type="date" />
                        </div>
                    </abp-column>

                    <abp-column size-lg="_3" size-md="_6">
                        <abp-input asp-for="@Model.Filter" suppress-label="true" type="text" />
                    </abp-column>

                    <abp-column size-lg="_1" size-md="_6">
                        <div class="d-grid gap-2">
                            <abp-button button-type="Primary" type="submit">
                                <i class="fa fa-search" aria-hidden="true"></i>@L["Search"].Value
                            </abp-button>
                        </div>
                    </abp-column>
                </abp-row>
            </form>
        </abp-card-body>
    </abp-card>
    <abp-card>
        <abp-card-body>
            <abp-table striped-rows="true" id="PurchaseOrderTable" class="nowrap"></abp-table>
        </abp-card-body>
    </abp-card>
</div>
