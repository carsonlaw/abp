  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MultiTenancy\MultiTenancyConsts.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="MultiTenancy\" />
  </ItemGroup>

</Project>
